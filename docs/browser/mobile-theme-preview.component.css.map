:host {
  display: flex;
  justify-content: center;
}

.phone-frame {
  position: relative;
  width: 260px;
  border: 10px solid #1a1a1a;
  border-radius: 2.5rem;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  overflow: hidden;
  background: #1a1a1a;
}

.phone-notch {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 90px;
  height: 18px;
  background: #1a1a1a;
  border-bottom-left-radius: 12px;
  border-bottom-right-radius: 12px;
  z-index: 2;
}

.phone-screen {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 540px;
  overflow: hidden;
  transition: background-color 0.15s ease;
}

.region {
  cursor: pointer;
  outline: none;
  transition: box-shadow 0.15s ease, transform 0.1s ease;
}

.region:hover {
  box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.6) inset;
}

.region-active {
  box-shadow: 0 0 0 2px #2196f3, 0 0 0 4px rgba(33, 150, 243, 0.35) !important;
}

.status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.6rem 1rem 0.35rem;
  font-size: 0.7rem;
  font-weight: 600;

  .status-icons {
    display: flex;
    gap: 0.35rem;
    font-size: 0.7rem;
  }
}

.app-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  padding: 0.6rem 0.85rem;

  i {
    font-size: 0.9rem;
  }

  .app-bar-title {
    flex: 1;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.15rem 0.25rem;
    border-radius: 4px;
  }
}

.phone-body {
  flex: 1;
  overflow-y: auto;
  padding: 0.85rem 0.75rem 4.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.promo-banner {
  border-radius: 10px;
  padding: 0.75rem;
  font-size: 0.75rem;
  font-weight: 600;
}

.text-block {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;

  .title-text {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: 4px;
    padding: 0.1rem 0.2rem;
    width: fit-content;
  }

  .subtitle-text {
    margin: 0;
    font-size: 0.7rem;
    border-radius: 4px;
    padding: 0.1rem 0.2rem;
    width: fit-content;
  }
}

.preview-card {
  border-radius: 12px;
  padding: 0.75rem;
  display: flex;
  align-items: center;
  gap: 0.65rem;

  .card-thumb {
    width: 42px;
    height: 42px;
    border-radius: 8px;
    border: 2px solid;
    flex-shrink: 0;
  }

  .card-lines {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;

    span {
      display: block;
      height: 6px;
      border-radius: 3px;

      &:first-child {
        width: 80%;
      }

      &:last-child {
        width: 55%;
        opacity: 0.8;
      }
    }
  }

  .card-chip {
    flex-shrink: 0;
    border-radius: 999px;
    padding: 0.2rem 0.55rem;

    span {
      font-size: 0.6rem;
      font-weight: 700;
    }
  }
}

.error-banner {
  border-radius: 10px;
  padding: 0.6rem 0.75rem;

  span {
    font-size: 0.72rem;
    font-weight: 600;
  }
}

.cta-button {
  border: none;
  border-radius: 999px;
  padding: 0.6rem;
  font-size: 0.8rem;
  font-weight: 700;
  cursor: pointer;
}

.fab {
  position: absolute;
  right: 1rem;
  bottom: 4.75rem;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 3px 8px rgba(0, 0, 0, 0.3);
  z-index: 3;

  i {
    font-size: 0.95rem;
  }
}

.bottom-nav {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0.65rem 0.5rem;
  border-top: 1px solid;
  z-index: 2;

  i {
    font-size: 1rem;
  }
}
