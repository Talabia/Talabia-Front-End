:host {
  display: block;
}

.empty-container {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  font-size: 1rem;
  font-weight: 600;
}

.action-container {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-block: 0.5rem;
}

.cursor-pointer {
  cursor: pointer;
}

.table-actions {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}

.input-container {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 0.25rem;
  margin-block: 0.75rem;

  label {
    span {
      color: var(--p-red-700);
    }
  }
}

.dialog-footer {
  display: flex;
  justify-content: center;
  gap: 0.75rem;
  margin-block-start: 1.5rem;
  padding-top: 1rem;
}

.color-display {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.color-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.color-square {
  width: 20px;
  height: 20px;
  border-radius: 4px;
  border: 1px solid var(--p-surface-border);
  box-shadow: 0.5px 0.5px 4px 0px var(--p-surface-400);

  :host-context(.my-app-dark) & {
    border: 1px solid var(--p-surface-border);
    box-shadow: 0.5px 0.5px 4px 0px var(--p-surface-700);
  }

  display: inline-block;
  flex-shrink: 0;
}

.color-label {
  font-size: 0.875rem;
  color: var(--p-text-color);
}

.form-section {
  margin-bottom: 2rem;

  h4 {
    margin-bottom: 1rem;
    color: var(--p-text-color);
    font-weight: 600;
    border-bottom: 1px solid var(--p-surface-border);
    padding-bottom: 0.5rem;
  }
}

.input-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
}

.preview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.5rem;

  h4 {
    margin: 0;
    border-bottom: none;
    padding-bottom: 0;
  }
}

.mode-toggle {
  display: flex;
  gap: 0.5rem;
}

.preview-hint {
  font-size: 0.8rem;
  color: var(--p-text-muted-color);
  margin: 0.25rem 0 1rem;
}

.color-popover-content {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 0.5rem;
  padding: 0.5rem;
  min-width: 220px;
}

.color-popover-label {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--p-text-color);
}

.hex-input {
  width: 100%;
  text-transform: lowercase;
}

.palette-section {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;

  .palette-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--p-text-color);
  }

  .color-preview {
    display: flex;
    gap: 0.25rem;
  }
}

.dialog-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  padding: 2rem;

  span {
    color: var(--p-text-muted-color);
  }
}
