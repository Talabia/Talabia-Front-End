<p-card [header]="'theme.header' | translate">
    <div class="card">
        <div class="action-container">
            <p-button (click)="showCreateDialog()" [label]="'theme.addButton' | translate" icon="pi pi-plus"
                [disabled]="loading" />
        </div>
        <p-table [value]="themes" [scrollable]="true" [paginator]="true" [rows]="rows" [first]="first"
            [totalRecords]="totalRecords" [lazy]="true" showGridlines stripedRows
            [currentPageReportTemplate]="pageReportTemplate" (onPage)="pageChange($event)"
            [rowsPerPageOptions]="[10, 25, 50]" scrollHeight="600px" [loading]="loading" [showCurrentPageReport]="true"
            paginatorPosition="bottom">

            <ng-template #header>
                <tr>
                    <th style="min-width:200px">{{'theme.table.name' | translate}}</th>
                    <th style="min-width:100px">{{'theme.table.colors' | translate}}</th>
                    <th style="min-width:100px">{{'theme.table.status' | translate}}</th>
                    <th style="min-width:100px">{{'theme.table.default' | translate}}</th>
                    <th style="min-width:100px">{{'theme.table.actions' | translate}}</th>
                </tr>
            </ng-template>

            <ng-template #body let-theme>
                <tr>
                    <td>{{theme.name}}</td>
                    <td>
                        <div class="color-display">
                            <div class="palette-section">
                                <span class="palette-title">{{'theme.palette.light' | translate}}</span>
                                <div class="color-preview">
                                    @for (key of palettePreviewKeys; track key) {
                                    <span class="color-square" [style.background-color]="theme.lightTheme[key]"
                                        [title]="key"></span>
                                    }
                                </div>
                            </div>
                            <div class="palette-section">
                                <span class="palette-title">{{'theme.palette.dark' | translate}}</span>
                                <div class="color-preview">
                                    @for (key of palettePreviewKeys; track key) {
                                    <span class="color-square" [style.background-color]="theme.darkTheme[key]"
                                        [title]="key"></span>
                                    }
                                </div>
                            </div>
                        </div>
                    </td>
                    <td>
                        @if (theme.isActive) {
                        <p-tag severity="success" [value]="'theme.status.active' | translate" />
                        } @else {
                        <p-tag severity="danger" [value]="'theme.status.inactive' | translate" />
                        }
                    </td>
                    <td>
                        @if (theme.isDefault) {
                        <p-tag severity="info" [value]="'theme.status.default' | translate" />
                        } @else {
                        <p-tag severity="secondary" [value]="'common.none' | translate" />
                        }
                    </td>
                    <td>
                        <div class="table-actions">
                            <p-button [pTooltip]="'theme.button.setDefault' | translate" [icon]="'pi pi-verified
'" [disabled]="loading || theme.isDefault" (click)="setAsDefault(theme)" />
                            <p-button
                                [pTooltip]="theme.isActive ? ('theme.button.deactivate' | translate) : ('theme.button.activate' | translate)"
                                [icon]="theme.isActive ? 'pi pi-times' : 'pi pi-check'"
                                [severity]="theme.isActive ? 'danger' : 'success'" [disabled]="loading"
                                (click)="toggleActiveStatus(theme, { checked: !theme.isActive })" />
                            <p-button severity="success" [pTooltip]="'common.edit' | translate" icon="pi pi-pencil"
                                [disabled]="loading" (click)="showEditDialog(theme)" />
                            <p-button severity="danger" [pTooltip]="'common.delete' | translate" icon="pi pi-trash"
                                [disabled]="loading" (click)="confirmDelete($event, theme)" />
                        </div>
                    </td>
                </tr>
            </ng-template>

            <ng-template pTemplate="emptymessage">
                <tr>
                    <td colspan="5">
                        @if (searchKeyword && searchKeyword.trim()) {
                        <div class="empty-container">
                            <i class="pi pi-search"></i>
                            <h4>{{'theme.empty.search' | translate:{ keyword: searchKeyword } }}</h4>
                        </div>
                        } @else {
                        <div class="empty-container">
                            <i class="pi pi-info-circle"></i>
                            <h4>{{'theme.empty.default' | translate}}</h4>
                        </div>
                        }
                    </td>
                </tr>
            </ng-template>
        </p-table>
    </div>
</p-card>

<!-- Create/Edit Dialog -->
<p-dialog [header]="dialogTitle" [modal]="true" [(visible)]="visible" [style]="{ width: '70rem' }" [closable]="!loading"
    [draggable]="false" [resizable]="false">
    @if (dialogLoading) {
    <div class="dialog-loading">
        <p-progressSpinner />
        <span>{{'common.loading' | translate}}</span>
    </div>
    } @else {
    <form [formGroup]="themeForm" (ngSubmit)="saveTheme()">
        <!-- Name and Description Fields -->
        <div class="form-section">
            <h4>{{'theme.form.basicInfo' | translate}}</h4>
            <div class="input-grid">
                <div class="input-container">
                    <label for="nameEn" class="font-semibold">{{'theme.form.nameEn' | translate}} <span>*</span></label>
                    <input pInputText id="nameEn" formControlName="nameEn" class="flex-auto" autocomplete="off"
                        [disabled]="loading" [invalid]="hasError('nameEn')" />
                    @if (hasError('nameEn')) {
                    <p-message severity="error" size="small" variant="simple">
                        {{getErrorMessage('nameEn')}}
                    </p-message>
                    }
                </div>

                <div class="input-container">
                    <label for="nameAr" class="font-semibold">{{'theme.form.nameAr' | translate}} <span>*</span></label>
                    <input pInputText id="nameAr" formControlName="nameAr" class="flex-auto" autocomplete="off"
                        [disabled]="loading" [invalid]="hasError('nameAr')" />
                    @if (hasError('nameAr')) {
                    <p-message severity="error" size="small" variant="simple">
                        {{getErrorMessage('nameAr')}}
                    </p-message>
                    }
                </div>

                <div class="input-container">
                    <label for="descriptionEn" class="font-semibold">{{'theme.form.descriptionEn' | translate}}
                        <span>*</span></label>
                    <textarea pTextarea id="descriptionEn" formControlName="descriptionEn" rows="2" [disabled]="loading"
                        [class.p-invalid]="hasError('descriptionEn')"></textarea>
                    @if (hasError('descriptionEn')) {
                    <p-message severity="error" size="small" variant="simple">
                        {{getErrorMessage('descriptionEn')}}
                    </p-message>
                    }
                </div>

                <div class="input-container">
                    <label for="descriptionAr" class="font-semibold">{{'theme.form.descriptionAr' | translate}}
                        <span>*</span></label>
                    <textarea pTextarea id="descriptionAr" formControlName="descriptionAr" rows="2" [disabled]="loading"
                        [class.p-invalid]="hasError('descriptionAr')"></textarea>
                    @if (hasError('descriptionAr')) {
                    <p-message severity="error" size="small" variant="simple">
                        {{getErrorMessage('descriptionAr')}}
                    </p-message>
                    }
                </div>
            </div>
        </div>

        <!-- Light Theme Palette -->
        <div class="form-section">
            <h4>{{'theme.palette.light' | translate}}</h4>
            <div class="palette-grid" formGroupName="light">
                @for (field of paletteFields; track field.key) {
                <div class="color-field">
                    <label [for]="'light-' + field.key" class="color-label">{{field.labelKey | translate}}</label>
                    <p-colorpicker [formControlName]="field.key" [inputId]="'light-' + field.key"
                        [disabled]="loading" />
                    @if (hasError('light.' + field.key)) {
                    <p-message severity="error" size="small" variant="simple">
                        {{getErrorMessage('light.' + field.key)}}
                    </p-message>
                    }
                </div>
                }
            </div>
        </div>

        <!-- Dark Theme Palette -->
        <div class="form-section">
            <h4>{{'theme.palette.dark' | translate}}</h4>
            <div class="palette-grid" formGroupName="dark">
                @for (field of paletteFields; track field.key) {
                <div class="color-field">
                    <label [for]="'dark-' + field.key" class="color-label">{{field.labelKey | translate}}</label>
                    <p-colorpicker [formControlName]="field.key" [inputId]="'dark-' + field.key" [disabled]="loading" />
                    @if (hasError('dark.' + field.key)) {
                    <p-message severity="error" size="small" variant="simple">
                        {{getErrorMessage('dark.' + field.key)}}
                    </p-message>
                    }
                </div>
                }
            </div>
        </div>

        <div class="dialog-footer">
            <p-button [label]="'theme.button.cancel' | translate" severity="secondary" type="button"
                [disabled]="loading" (click)="cancelDialog()" />
            <p-button [label]="isEditMode ? ('theme.button.update' | translate) : ('theme.button.create' | translate)"
                type="submit" [loading]="loading" [disabled]="isSaveDisabled()" />
        </div>
    </form>
    }
</p-dialog>

<p-toast />
<p-confirmpopup />